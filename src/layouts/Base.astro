---
import '~/styles/global.css';
import Search from '~/components/Search.tsx';
import Spine from '~/components/Spine.astro';
import { totals } from '~/lib/data';

// The two faces that draw first paint. Everything else (mono, and the non-latin
// subsets) can wait for the stylesheet to ask for it.
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Stage slug — when set, the spine renders and marks this stage. */
  spine?: string;
  /** Which top-level nav item to mark current. */
  nav?: 'stages' | 'stacks' | 'submit' | 'about';
  /** JSON-LD object, serialised into the head. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Suppress the site title suffix — the homepage sets its own. */
  bareTitle?: boolean;
}

const { title, description, spine, nav, jsonLd, bareTitle = false } = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const fullTitle = bareTitle ? title : `${title} · Founder Index`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Founder Index" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#eaedf2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0d12" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='4' fill='%230f131a'/%3E%3Crect x='7' y='7' width='4' height='18' rx='1' fill='%23b02d18'/%3E%3Crect x='14' y='7' width='11' height='3' rx='1' fill='%23eaedf2'/%3E%3Crect x='14' y='14' width='11' height='3' rx='1' fill='%23eaedf2' opacity='.6'/%3E%3Crect x='14' y='21' width='11' height='3' rx='1' fill='%23eaedf2' opacity='.35'/%3E%3C/svg%3E"
    />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }

    {/* Applies the stored theme before first paint, so the page never flashes. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('fi-theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="wordmark" href="/">
          <span class="wordmark__mark" aria-hidden="true"></span>
          Founder Index
        </a>

        <nav class="nav" aria-label="Main">
          <a href="/" aria-current={nav === 'stages' ? 'page' : undefined}>Stages</a>
          <a href="/stacks" aria-current={nav === 'stacks' ? 'page' : undefined}>Stacks</a>
          <a href="/submit" aria-current={nav === 'submit' ? 'page' : undefined}>Submit</a>
          <a href="/about" aria-current={nav === 'about' ? 'page' : undefined}>About</a>
        </nav>

        <Search client:idle mode="palette" />

        <button
          type="button"
          class="chip"
          id="theme-toggle"
          aria-label="Switch between light and dark"
          title="Switch between light and dark"
        >
          <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
            <path
              d="M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm0 1.5v2M8 1.5v2M12.6 12.6l1.4 1.4M2 2l1.4 1.4M12.6 3.4 14 2M2 14l1.4-1.4M11.5 8h2M2.5 8h2"
              stroke="currentColor"
              stroke-width="1.3"
              fill="none"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </header>

    {spine && <Spine current={spine} />}

    <main id="main" class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div
          style="display:flex;flex-wrap:wrap;gap:1.5rem 2.5rem;align-items:flex-start;justify-content:space-between"
        >
          <p class="prose-measure" style="max-width:44ch">
            {totals.entries} resources across {totals.stages} stages, kept in a JSON file in
            a public repo. No paid placement, ever — anyone can add to it with a pull
            request.
          </p>
          <nav aria-label="Footer" style="display:grid;gap:0.35rem">
            <a class="mono" style="text-decoration:none" href="/stacks">Stacks</a>
            <a class="mono" style="text-decoration:none" href="/tags">All tags</a>
            <a class="mono" style="text-decoration:none" href="/unverified">
              Unverified ({totals.unverified})
            </a>
            <a class="mono" style="text-decoration:none" href="/submit">Submit a resource</a>
            <a class="mono" style="text-decoration:none" href="/about">About</a>
          </nav>
        </div>
        <p class="mono" style="margin-top:2rem;text-transform:none;letter-spacing:0.02em">
          © {year} · Code MIT, data CC BY 4.0
        </p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var root = document.documentElement;
          var current =
            root.dataset.theme ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          var next = current === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('fi-theme', next);
          } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
